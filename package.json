{
  "name": "sambu-online",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run test:client && npm run test:integration",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "build:vps": "BUILD_TARGET=node vinext build",
    "start:vps": "node dist/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --test tests/vps.integration.test.mjs tests/migration.test.mjs tests/auth-proxy.test.mjs tests/storage.test.mjs tests/storage-disk.test.mjs tests/auth-local.test.mjs",
    "test:client": "node --test tests/client-api.test.mjs tests/reader-blocks.test.mjs tests/catalog-transfer.test.mjs",
    "db:migrate:vps": "node scripts/migrate-vps.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Sambu"
}
